# MirrorQuant Environment Configuration
# Copy this file to .env and adjust values for production.

# Application
MQ_APP_NAME=MirrorQuant
MQ_ENV=production
MQ_HOST=0.0.0.0
MQ_PORT=8000
MQ_LOG_LEVEL=INFO
MQ_DATA_DIR=/app/data

# Database (SQLite WAL mode by default; supports sqlite+aiosqlite)
MQ_DATABASE_URL=sqlite+aiosqlite:///./data/mirrorquant.db

# Security Keys (Leave blank to auto-generate and persist in MQ_DATA_DIR on first boot)
# Generate custom 32-byte base64 master key: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MQ_MASTER_KEY=
MQ_JWT_SECRET=
# Required for first administrator setup. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same token on the setup page. Keep it private and remove it after initialization.
MQ_BOOTSTRAP_TOKEN=
MQ_COOKIE_SECURE=false
MQ_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed console origins for HTTP and authenticated WebSockets. Add your deployed HTTPS origin.
MQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8080

# Engine Loops
MQ_ENABLE_BACKGROUND_ENGINE=true
MQ_DEFAULT_LEAD_POLL_SEC=15
MQ_PRICE_TICK_SEC=5
