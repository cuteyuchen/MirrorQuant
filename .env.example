# MirrorQuant Environment Configuration
# Copy this file to .env and adjust values for production.

# Application
MQ_APP_NAME=MirrorQuant
MQ_ENV=production
MQ_HOST=0.0.0.0
MQ_PORT=8000
MQ_LOG_LEVEL=INFO
MQ_DATA_DIR=/app/data

# Database (SQLite WAL mode by default; supports sqlite+aiosqlite)
MQ_DATABASE_URL=sqlite+aiosqlite:///./data/mirrorquant.db

# Security Keys (Leave blank to auto-generate and persist in MQ_DATA_DIR on first boot)
# Generate custom 32-byte base64 master key: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MQ_MASTER_KEY=
MQ_JWT_SECRET=
# Required for first administrator setup. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same token on the setup page. Keep it private and remove it after initialization.
MQ_BOOTSTRAP_TOKEN=
MQ_COOKIE_SECURE=false
MQ_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed console origins for HTTP and authenticated WebSockets. Add your deployed HTTPS origin.
MQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8080

# Proxy/load-balancer CIDRs allowed to supply client IP headers.
# Only list addresses you control; leave at loopback-only when not behind a proxy.
MQ_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
MQ_COOKIE_NAME=mq_access_token

# Engine Loops
MQ_ENABLE_BACKGROUND_ENGINE=true
MQ_DEFAULT_LEAD_POLL_SEC=15
MQ_PRICE_TICK_SEC=5
# Lead snapshot considered stale after this many seconds (reject too-old lead data).
MQ_LEAD_SNAPSHOT_STALE_SEC=300
# Consecutive lead-sync failures before the loop backs off / alerts.
MQ_LEAD_SYNC_FAILURE_LIMIT=3
MQ_PA_KLINE_MAX_STALENESS_MULTIPLIER=3.0

# Readiness probes
MQ_READINESS_HEARTBEAT_MAX_AGE_SEC=30
MQ_READINESS_DB_TIMEOUT_SEC=2

# Notification outbox retry policy
MQ_NOTIFICATION_OUTBOX_MAX_ATTEMPTS=3
MQ_NOTIFICATION_OUTBOX_POLL_SEC=1.0

# Exchange egress policy (explicit lists override the legacy global fallback).
# Only the selected route is used; HTTP(S)_PROXY environment variables are ignored.
MQ_ALLOW_DIRECT_EGRESS=true
MQ_PROXY_REQUIRED_EXCHANGES=binance
MQ_DIRECT_EGRESS_EXCHANGES=okx,bybit,bitget
